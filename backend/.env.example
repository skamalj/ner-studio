# Copy to .env and fill in what you need. Nothing here is required to start
# the server; a provider simply shows as "not configured" in the UI until its
# credentials are present.

# --- AWS (Textract + Bedrock) --------------------------------------------
# Uses the standard boto3 credential chain, so `aws sso login` works as-is.
AWS_REGION=us-east-1
# AWS_PROFILE=my-sso-profile

# --- API keys -------------------------------------------------------------
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# GOOGLE_API_KEY=...

# --- defaults -------------------------------------------------------------
DEFAULT_PROVIDER=bedrock
DEFAULT_MODEL=qwen.qwen3-235b-a22b-2507-v1:0
DEFAULT_TEMPERATURE=0.5
CHUNK_TOKEN_LIMIT=10000
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# LOCAL_BASE_URL=http://127.0.0.1:8085/v1
